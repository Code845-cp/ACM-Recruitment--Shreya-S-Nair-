def solution(arr):
    max1 = arr[0]
    for i in range(1, len(arr)):
        if arr[i] > max1:
            max1 = arr[i]
    
    arr_copy = arr[:]  
    arr_copy.remove(max1) 
    
    max2 = arr_copy[0]
    for j in range(1, len(arr_copy)):
        if arr_copy[j] > max2:
            max2 = arr_copy[j]
    
    return max2
solution([12, 35, 1, 10, 34, 1])
